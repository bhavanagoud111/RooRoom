# Copy to .env and fill in. scripts/make-env.sh generates every secret except the OpenRouter key.
OPENROUTER_API_KEY=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
MODERATOR_DB_PASSWORD=
MINIO_ROOT_USER=rooroom
MINIO_ROOT_PASSWORD=
# 32 bytes, base64. Encrypts chat messages and anonymous notes. Never stored in the database.
CONTENT_KEY=
CHAT_TICKET_SECRET=
WORKER_TOKEN=
PUBLIC_ORIGIN=http://localhost:3300
ALLOWED_EMAIL_DOMAIN=umkc.edu
# Demo only: shows the email verification code on screen because RooRoom never sends email.
DEV_SHOW_CODES=true
