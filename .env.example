# Copy to .env and fill in. scripts/make-env.sh generates every secret except the OpenRouter key.
OPENROUTER_API_KEY=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
MODERATOR_DB_PASSWORD=
MINIO_ROOT_USER=rooroom
MINIO_ROOT_PASSWORD=
# 32 bytes, base64. Encrypts chat messages and anonymous notes. Never stored in the database.
CONTENT_KEY=
CHAT_TICKET_SECRET=
WORKER_TOKEN=
PUBLIC_ORIGIN=http://localhost:3300
ALLOWED_EMAIL_DOMAIN=umkc.edu
# Demo only: shows the email verification code on screen because RooRoom never sends email.
DEV_SHOW_CODES=true
# Sign-in codes by email (Gmail + app password). Leave both empty to switch codes off.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Accounts that never get a code and are never emailed: the made-up demo accounts, plus anyone
# who must sign in during a live demo. Comma-separated.
OTP_SKIP_EMAILS=okafor@umkc.edu,lindqvist@umkc.edu,bauer@umkc.edu,amara@umkc.edu,diego@umkc.edu,fatima@umkc.edu,hana@umkc.edu,jonah@umkc.edu,kenji@umkc.edu,lena@umkc.edu,lucas@umkc.edu,omar@umkc.edu,priya@umkc.edu,sofia@umkc.edu,wei@umkc.edu,rafida.zaman@umkc.edu
